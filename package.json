{
  "name": "wetrace",
  "version": "0.2.0",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop": "electron desktop/main.cjs",
    "desktop:pack": "electron-builder --dir",
    "desktop:build:win": "electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jszip": "3.10.1",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.oppaproductions.wetrace",
    "productName": "WETrace",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WETrace",
      "uninstallDisplayName": "WETrace"
    }
  }
}